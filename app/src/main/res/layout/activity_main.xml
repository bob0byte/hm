<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shizukuStatus"
            style="@style/Hint"
            android:layout_marginTop="2dp"
            android:text="Shizuku: checking…" />

        <Button
            android:id="@+id/grantButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Give Shizuku access"
            android:visibility="gone" />

        <!-- Live numbers -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statScreen"
                        style="@style/StatValue"
                        android:text="--" />

                    <TextView
                        android:id="@+id/statScreenLabel"
                        style="@style/StatLabel"
                        android:text="SCREEN HZ" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statGame"
                        style="@style/StatValue"
                        android:text="--" />

                    <TextView
                        android:id="@+id/statGameLabel"
                        style="@style/StatLabel"
                        android:text="GAME FPS" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statRam"
                        style="@style/StatValue"
                        android:text="--" />

                    <TextView
                        android:id="@+id/statRamLabel"
                        style="@style/StatLabel"
                        android:text="GB RAM FREE" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Auto game mode -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout style="@style/CardBody">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/autoMode"
                    style="@style/Toggle"
                    android:text="Auto game mode"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/autoStatus"
                    style="@style/Hint"
                    android:text="Off. Turn it on and the app boosts by itself whenever one of your games opens, then puts everything back when you leave." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Games -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout style="@style/CardBody">

                <TextView
                    style="@style/CardTitle"
                    android:text="My games" />

                <TextView
                    android:id="@+id/gamesList"
                    style="@style/Hint"
                    android:layout_marginTop="4dp"
                    android:text="None chosen yet" />

                <Button
                    android:id="@+id/chooseGames"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Choose games" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Screen -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout style="@style/CardBody">

                <TextView
                    style="@style/CardTitle"
                    android:text="Screen" />

                <TextView
                    style="@style/Hint"
                    android:text="Refresh rate while playing" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/rateChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:selectionRequired="true"
                    app:singleSelection="true" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/lockSwitch"
                    style="@style/Toggle"
                    android:text="Lock it so the system can't drop lower" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Speed and input lag -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout style="@style/CardBody">

                <TextView
                    style="@style/CardTitle"
                    android:text="Speed and input lag" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/uncapSwitch"
                    style="@style/Toggle"
                    android:text="Remove Android's game FPS cap" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/perfSwitch"
                    style="@style/Toggle"
                    android:text="Performance mode for the game" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/saverSwitch"
                    style="@style/Toggle"
                    android:text="Turn battery saver off" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/dndSwitch"
                    style="@style/Toggle"
                    android:text="Do not disturb while playing" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/overlaySwitch"
                    style="@style/Toggle"
                    android:text="Show FPS counter in game" />

                <TextView
                    style="@style/Hint"
                    android:layout_marginTop="8dp"
                    android:text="Render resolution (lower = faster frames, blurrier picture)" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/scaleChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:selectionRequired="true"
                    app:singleSelection="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- RAM -->
        <com.google.android.material.card.MaterialCardView style="@style/Card">

            <LinearLayout style="@style/CardBody">

                <TextView
                    style="@style/CardTitle"
                    android:text="RAM cleaner" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/ramChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:selectionRequired="true"
                    app:singleSelection="true" />

                <TextView
                    android:id="@+id/ramHint"
                    style="@style/Hint" />

                <TextView
                    android:id="@+id/ramSliderLabel"
                    style="@style/Hint"
                    android:layout_marginTop="12dp"
                    android:text="Clear every 30 seconds" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/ramSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="5"
                    android:value="30"
                    android:valueFrom="10"
                    android:valueTo="120"
                    app:labelBehavior="gone" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="Apps to never close (optional)"
                    app:helperText="Package names with commas, e.g. com.whatsapp, com.discord">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/keepList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textNoSuggestions|textMultiLine" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/boostNowButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Clear RAM now" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Manual -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/applyButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Apply now" />

            <Button
                android:id="@+id/undoButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Undo everything" />
        </LinearLayout>

        <TextView
            android:id="@+id/resultLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/details"
            style="@style/Hint"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:textIsSelectable="true"
            android:visibility="gone" />

        <TextView
            style="@style/Hint"
            android:layout_marginTop="20dp"
            android:text="Good to know: no app can make a game draw frames faster than the game itself decides to. This app removes every limit Android adds on top. If the in-game counter shows a GPU number, the game is already drawing more frames than your screen can show." />
    </LinearLayout>
</ScrollView>
